APP_NAME="AI Red Team Reporting Assistant"
APP_ENV="development"
DEBUG=false
HOST="0.0.0.0"
PORT=8000

BASE_DATA_DIR="project/data"
UPLOADS_DIR="project/data/uploads"
PROCESSED_DIR="project/data/processed"
OCR_DIR="project/data/ocr"
REPORTS_DIR="project/data/reports"
TEMPLATES_DIR="project/data/templates"

MAX_IMAGE_DIMENSION=2200
JPEG_QUALITY=88
THUMBNAIL_SIZE=320

AI_PROVIDER="openai_compatible"
AI_API_KEY=""
AI_BASE_URL="https://api.openai.com/v1"
AI_MODEL="gpt-4.1-mini"
AI_TIMEOUT_SECONDS=60

ANALYZE_RATE_LIMIT_PER_MINUTE=6
EXPORT_RATE_LIMIT_PER_MINUTE=12
